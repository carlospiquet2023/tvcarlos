# ==================================
# EduVault — Variáveis de Ambiente
# ==================================
# Copie este arquivo para .env e preencha os valores:
#   cp .env.example .env
# ==================================

# ==================== BANCO DE DADOS ====================
# PostgreSQL com connection pool otimizado
DATABASE_URL="postgresql://usuario:senha@localhost:5432/eduvault?connection_limit=20"

# ==================== AUTENTICAÇÃO ====================
# Chave JWT (OBRIGATÓRIA — servidor NÃO inicia sem ela)
# Gerar: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="COLOQUE_AQUI_UM_HASH_ALEATORIO_DE_64_CARACTERES"
TRUST_PROXY="1"
COOKIE_SECURE="false"
AUTH_TTL_HOURS="8"
MIGRATION_MODE="deploy"
APP_TIMEZONE="America/Sao_Paulo"

# ==================== SERVIDOR ====================
PORT=4000
FRONTEND_URL="http://localhost:5173"
NODE_ENV="development"

# ==================== ARMAZENAMENTO ====================
# Caminhos relativos (dev) ou absolutos (produção)
VIDEO_STORAGE_PATH="./uploads/videos"
HLS_STORAGE_PATH="./uploads/hls"
IMAGE_STORAGE_PATH="./uploads/images"
PDF_STORAGE_PATH="./uploads/pdfs"

# ==================== PROCESSOS ====================
# A API e o worker usam entrypoints separados (`npm start` e `npm run start:worker`).
# PROCESS_ROLE="api"       # usado apenas pelo entrypoint Docker: api | worker
# RUN_MIGRATIONS="true"    # somente a API/job único aplica migrations
# LOG_LEVEL="info"         # debug | info | warn | error

# ==================== E-MAIL (SMTP) ====================
# Necessário para envio automático de login/senha aos alunos
SMTP_HOST="smtp.seuprovedor.com"
SMTP_PORT=587
SMTP_USER="usuario@dominio.com"
SMTP_PASS="senha-ou-app-password"
SMTP_FROM="Plataforma <nao-responda@dominio.com>"
SMTP_SECURE="false"
PLATFORM_NAME="EduVault"

# ==================== BROADCAST / IA ====================
# URL interna do container RTMP/HLS; não é uma URL pública.
BROADCAST_INTERNAL_URL="http://broadcast:8080"
# Gere duas chaves aleatórias e diferentes. Os valores nunca vão para o frontend.
RTMP_STREAM_KEY="COLOQUE_AQUI_UMA_CHAVE_LIVE_ALEATORIA_DE_64_CARACTERES"
LOOP_STREAM_KEY="COLOQUE_AQUI_UMA_CHAVE_LOOP_ALEATORIA_DE_64_CARACTERES"
# Deixe vazio em desenvolvimento para manter a IA desabilitada.
GROQ_API_KEY=""
GROQ_MODEL="meta-llama/llama-4-scout-17b-16e-instruct"
GROQ_FALLBACK_MODEL="openai/gpt-oss-120b"
GROQ_MODEL_SWITCH_AT="2026-07-17T00:00:00.000Z"
GROQ_TIMEOUT_MS="20000"
GROQ_MAX_TOKENS="1200"
AI_RATE_LIMIT_MAX="20"
AI_RATE_LIMIT_WINDOW_MS="900000"

# Seed inicial opt-in. Nunca reutilize estas credenciais em outro ambiente.
SEED_ON_START="false"
ADMIN_INITIAL_EMAIL=""
ADMIN_INITIAL_USERNAME=""
ADMIN_INITIAL_PASSWORD=""
ADMIN_INITIAL_NAME="Administrador da Plataforma"
SEED_DEMO_DATA="false"
DEMO_STUDENT_PASSWORD=""
