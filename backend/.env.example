# ==================================
# EduVault — Variáveis de Ambiente
# ==================================
# Copie este arquivo para .env e preencha os valores:
#   cp .env.example .env
# ==================================

# ==================== BANCO DE DADOS ====================
# PostgreSQL com connection pool otimizado
DATABASE_URL="postgresql://usuario:senha@localhost:5432/eduvault?connection_limit=20"

# ==================== AUTENTICAÇÃO ====================
# Chave JWT (OBRIGATÓRIA — servidor NÃO inicia sem ela)
# Gerar: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="COLOQUE_AQUI_UM_HASH_ALEATORIO_DE_64_CARACTERES"

# ==================== SERVIDOR ====================
PORT=4000
FRONTEND_URL="http://localhost:5173"
NODE_ENV="development"

# ==================== ARMAZENAMENTO ====================
# Caminhos relativos (dev) ou absolutos (produção)
VIDEO_STORAGE_PATH="./uploads/videos"
HLS_STORAGE_PATH="./uploads/hls"
IMAGE_STORAGE_PATH="./uploads/images"
PDF_STORAGE_PATH="./uploads/pdfs"

# ==================== PRODUÇÃO (PM2) ====================
# Apenas para produção com PM2 cluster mode:
# PGBOSS_WORKER="true"   # Ativar em apenas 1 instância (eduvault-worker)
# LOG_LEVEL="info"        # debug | info | warn | error
