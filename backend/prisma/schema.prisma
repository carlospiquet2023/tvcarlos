generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             String   @id @default(uuid())
  username       String?  @unique
  email          String   @unique
  password       String
  name           String
  role           Role     @default(STUDENT)
  enrollments    CourseEnrollment[]
  history        VideoHistory[]
  auditLogs      AuditLog[]
  notifications  Notification[]
  comments       LessonComment[]
  commentReports CommentReport[]
  forumViolations ForumViolation[]
  forumBans       ForumBan[]
  forumAppeals    ForumAppeal[]
  attendances     Attendance[]
  attendanceEdits AttendanceEdit[] @relation("AttendanceEditedBy")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

enum Role {
  ADMIN
  TEACHER
  STUDENT
}

model Course {
  id           String   @id @default(uuid())
  name         String
  description  String?
  thumbnailUrl String?
  calendarUrl  String?
  order        Int      @default(0)
  enrollments  CourseEnrollment[]
  modules      Module[]
  liveClasses  LiveClass[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model CourseEnrollment {
  id             String         @id @default(uuid())
  user           User           @relation(fields: [userId], references: [id])
  userId         String
  course         Course         @relation(fields: [courseId], references: [id])
  courseId        String
  enrollmentRole EnrollmentRole @default(STUDENT)
  createdAt      DateTime       @default(now())

  @@unique([userId, courseId])
  @@index([userId])
  @@index([courseId])
}

enum EnrollmentRole {
  STUDENT
  TEACHER
}

model Module {
  id        String   @id @default(uuid())
  name      String
  pdfUrl    String?
  course    Course   @relation(fields: [courseId], references: [id])
  courseId  String
  videos      Video[]
  liveClasses LiveClass[]
  attendances Attendance[]
  order       Int      @default(0)
  createdAt   DateTime @default(now())

  @@index([courseId])
}

model Video {
  id              String   @id @default(uuid())
  title           String
  description     String?
  content         String?  @db.Text
  thumbnailUrl    String?
  originalUrl     String?
  hlsUrl          String?
  status          VideoStatus @default(PENDING)
  commentsEnabled Boolean  @default(true)
  module          Module   @relation(fields: [moduleId], references: [id])
  moduleId        String
  order           Int      @default(0)
  history         VideoHistory[]
  liveClasses     LiveClass[]
  comments        LessonComment[]
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([moduleId])
}

enum VideoStatus {
  PENDING
  PROCESSING
  READY
  ERROR
}

model VideoHistory {
  id        String   @id @default(uuid())
  user      User     @relation(fields: [userId], references: [id])
  userId    String
  video     Video    @relation(fields: [videoId], references: [id])
  videoId   String
  progress  Int      @default(0) // Seconds or percentage
  completed Boolean  @default(false)
  updatedAt DateTime @updatedAt

  @@unique([userId, videoId])
  @@index([userId])
  @@index([videoId])
}

model PlatformConfig {
  id                    String   @id @default(uuid())
  platformName          String   @default("EduVault")
  namePart1             String   @default("Edu")
  namePart2             String   @default("Vault")
  nameColor1            String   @default("#e50914")
  nameColor2            String   @default("#ffffff")
  primaryColor          String   @default("#6366f1")
  accentColor           String   @default("#ec4899")
  logoUrl               String?
  bannerUrl             String?
  forumPunishmentEnabled Boolean @default(false)
  attendanceEnabled      Boolean @default(false)
  attendanceMinMinutes   Int     @default(20)
  attendanceMode         String  @default("FREE") // DATE_ONLY or FREE
  updatedAt             DateTime @updatedAt
}

model AuditLog {
  id        String   @id @default(uuid())
  user      User     @relation(fields: [userId], references: [id])
  userId    String
  action    String
  target    String
  details   String?  @db.Text
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
}

model Notification {
  id        String   @id @default(uuid())
  user      User     @relation(fields: [userId], references: [id])
  userId    String
  title     String
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
}

model LiveClass {
  id               String          @id @default(uuid())
  course           Course          @relation(fields: [courseId], references: [id])
  courseId          String
  module           Module?         @relation(fields: [moduleId], references: [id])
  moduleId         String?
  title            String
  description      String?
  startAt          DateTime
  endAt            DateTime?
  zoomJoinUrl      String
  zoomStartUrl     String?
  zoomMeetingId    String?
  status           LiveClassStatus @default(SCHEDULED)
  recordingVideo   Video?          @relation(fields: [recordingVideoId], references: [id])
  recordingVideoId String?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@index([courseId])
  @@index([status])
  @@index([startAt])
}

enum LiveClassStatus {
  SCHEDULED
  LIVE
  ENDED
  RECORDED
}

model LessonComment {
  id        String   @id @default(uuid())
  text      String   @db.Text
  flagged   Boolean  @default(false)
  user      User     @relation(fields: [userId], references: [id])
  userId    String
  video     Video    @relation(fields: [videoId], references: [id], onDelete: Cascade)
  videoId   String
  parent    LessonComment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  parentId  String?
  replies   LessonComment[] @relation("CommentReplies")
  reports   CommentReport[]
  createdAt DateTime @default(now())

  @@index([videoId])
  @@index([parentId])
  @@index([flagged])
}

model CommentReport {
  id        String   @id @default(uuid())
  comment   LessonComment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  commentId String
  user      User     @relation(fields: [userId], references: [id])
  userId    String
  reason    String
  createdAt DateTime @default(now())

  @@unique([commentId, userId])
  @@index([commentId])
}

enum ViolationSeverity {
  LIGHT
  MEDIUM
  SEVERE
}

model ForumViolation {
  id           String            @id @default(uuid())
  user         User              @relation(fields: [userId], references: [id])
  userId       String
  word         String
  severity     ViolationSeverity
  message      String            @db.Text
  autoAction   String?           // BAN_1D, BAN_2D, BAN_10D, BAN_PERMANENT, COMMITTEE
  createdAt    DateTime          @default(now())

  @@index([userId])
  @@index([createdAt])
}

model ForumBan {
  id         String    @id @default(uuid())
  user       User      @relation(fields: [userId], references: [id])
  userId     String
  reason     String    @db.Text
  banType    String    // TEMP_1D, TEMP_2D, TEMP_10D, PERMANENT
  expiresAt  DateTime?
  active     Boolean   @default(true)
  liftedBy   String?   // admin who lifted it
  liftedAt   DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId])
  @@index([active])
  @@index([expiresAt])
}

model ForumAppeal {
  id         String   @id @default(uuid())
  user       User     @relation(fields: [userId], references: [id])
  userId     String
  reason     String   @db.Text
  status     String   @default("PENDING") // PENDING, APPROVED, REJECTED
  adminNote  String?  @db.Text
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([userId])
  @@index([status])
}

// ============================================================
// SISTEMA DE PRESENÇA / ATTENDANCE
// ============================================================

model Attendance {
  id               String           @id @default(uuid())
  user             User             @relation(fields: [userId], references: [id])
  userId           String
  module           Module           @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  moduleId         String
  date             DateTime         @db.Date
  status           AttendanceStatus @default(ABSENT)
  watchTimeSeconds Int              @default(0)
  autoDetected     Boolean          @default(false)
  edits            AttendanceEdit[]
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@unique([userId, moduleId, date])
  @@index([userId])
  @@index([moduleId])
  @@index([date])
  @@index([status])
}

enum AttendanceStatus {
  PRESENT
  ABSENT
}

model AttendanceEdit {
  id             String     @id @default(uuid())
  attendance     Attendance @relation(fields: [attendanceId], references: [id], onDelete: Cascade)
  attendanceId   String
  editedBy       User       @relation("AttendanceEditedBy", fields: [editedByUserId], references: [id])
  editedByUserId String
  oldStatus      String
  newStatus      String
  justification  String     @db.Text
  createdAt      DateTime   @default(now())

  @@index([attendanceId])
  @@index([editedByUserId])
}
