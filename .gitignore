# ==================================
# EduVault — Gitignore Raiz
# ==================================

# Dependências
node_modules/

# Build outputs
backend/dist/
frontend/dist/
coverage/
*.tsbuildinfo

# Logs (PM2 e aplicação)
logs/
*.log

# Ambiente
.env
.env.*
.env.local
.env.prod
.env.production
!.env.example
!.env.prod.example
!backend/.env.example

# Uploads (dados do usuário — não versionar)
backend/uploads/

# PM2
.pm2/

# Sistema
.DS_Store
Thumbs.db
desktop.ini
*.swp
*.swo

# Estado local de CLIs
.railway/

# Rascunhos e scripts locais de migração manual
fix_files.js
arque.md
