# Copie para .env.prod e preencha os valores reais
# cp .env.prod.example .env.prod

POSTGRES_DB=eduvault
POSTGRES_USER=eduvault
POSTGRES_PASSWORD=troque-senha-forte-do-postgres
# A senha desta URL deve representar POSTGRES_PASSWORD com caracteres
# reservados percent-encoded (por exemplo, @ vira %40).
DATABASE_URL=postgresql://eduvault:troque-senha-percent-encoded@db:5432/eduvault?connection_limit=20

# Obrigatorio: use um segredo longo e aleatorio
JWT_SECRET=troque-por-um-segredo-longo-e-aleatorio
TRUST_PROXY=1
COOKIE_SECURE=true
AUTH_TTL_HOURS=8
APP_TIMEZONE=America/Sao_Paulo

# Dominio publico da plataforma
PUBLIC_DOMAIN=seu-dominio.com.br
FRONTEND_URL=https://seu-dominio.com.br
VITE_API_URL=https://seu-dominio.com.br
HTTP_BIND_ADDRESS=0.0.0.0
HTTP_PORT=80

# SMTP (opcional)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_SECURE=false
PLATFORM_NAME=EduVault

# Em producao mantenha false
SEED_ON_START=false

# Broadcast ao vivo. Gere chaves diferentes, aleatorias e com 64+ caracteres.
# Mantenha 127.0.0.1 se o OBS entra por VPN/túnel local. Use 0.0.0.0 somente
# com firewall/allowlist, pois RTMP puro não cifra o token em trânsito.
RTMP_BIND_ADDRESS=127.0.0.1
RTMP_PORT=1935
RTMP_STREAM_KEY=troque-por-uma-chave-live-aleatoria-com-64-ou-mais-caracteres
LOOP_STREAM_KEY=troque-por-uma-chave-loop-diferente-com-64-ou-mais-caracteres

# Groq é acessado exclusivamente pelo backend. Nunca prefixe com VITE_ e nunca
# grave uma chave real neste arquivo versionado. Rotacione a chave exposta antes.
GROQ_API_KEY=insira-aqui-uma-chave-nova-somente-no-ambiente-de-deploy
GROQ_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
GROQ_FALLBACK_MODEL=openai/gpt-oss-120b
GROQ_MODEL_SWITCH_AT=2026-07-17T00:00:00.000Z
GROQ_TIMEOUT_MS=20000
GROQ_MAX_TOKENS=1200
AI_RATE_LIMIT_MAX=20
AI_RATE_LIMIT_WINDOW_MS=900000
